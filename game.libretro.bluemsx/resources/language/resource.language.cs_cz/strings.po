msgctxt "Addon Summary"
msgid "MSX/SVI/ColecoVision/SG-1000 (blueMSX)"
msgstr "MSX/SVI/ColecoVision/SG-1000 (blueMSX)"

msgctxt "Addon Description"
msgid "BlueMSX is a rich MSX emulator. It supports most common machines and a wide variety of extension hardware."
msgstr "blueMSX je bohatě vybavený emulátor MSX. Podporuje většinu běžných strojů a širokou škálu rozšiřujícího hardwaru."

msgctxt "Addon Disclaimer"
msgid "Authors: Daniel Vik, Benoit Delvaux, Tomas Karlsson, Johan van Leur, Ricardo Bittencourt and Ray Zero"
msgstr "Autoři: Daniel Vik, Benoit Delvaux, Tomas Karlsson, Johan van Leur, Ricardo Bittencourt a Ray Zero"

msgctxt "#30001"
msgid "Machine Type (Restart)"
msgstr "Typ stroje (vyžaduje restart)"

msgctxt "#30002"
msgid "Crop Overscan"
msgstr "Oříznout overscan"

msgctxt "#30003"
msgid "VDP Sync Type (Restart)"
msgstr "Typ synchronizace VDP (vyžaduje restart)"

msgctxt "#30004"
msgid "No Sprite Limit"
msgstr "Bez limitu spritů"

msgctxt "#30005"
msgid "Sound YM2413 Enable (Restart)"
msgstr "Povolit zvuk YM2413 (vyžaduje restart)"

msgctxt "#30006"
msgid "Cart Mapper Type (Restart)"
msgstr "Typ mapperu cartridge (vyžaduje restart)"

msgctxt "#30007"
msgid "Auto Rewind Cassette"
msgstr "Automatické převinutí kazety"

msgctxt "#30008"
msgid "I/O Sound Enable"
msgstr "Povolit zvuk I/O"

msgctxt "#30009"
msgid "Colecovision Keyboard Mapping"
msgstr "Mapování klávesnice ColecoVision"

msgctxt "#30010"
msgid "Patch Colecovision ROM Fast Boot (Close Content)"
msgstr "Upravit ROM ColecoVision pro rychlé spuštění (zavřít obsah)"

msgctxt "#30011"
msgid "Use F12 to hard reset and restart emulation"
msgstr "Použít F12 pro hard reset a restart emulace"

msgctxt "#30012"
msgid "Additional MSX Sound Cartridge (Restart)"
msgstr "Dodatečná zvuková cartridge MSX (vyžaduje restart)"

msgctxt "#30013"
msgid "SunriseIDE Enable (Restart)"
msgstr "Povolit SunriseIDE (vyžaduje restart)"
