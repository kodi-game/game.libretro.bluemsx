msgctxt "Addon Summary"
msgid "MSX/SVI/ColecoVision/SG-1000 (blueMSX)"
msgstr "MSX/SVI/ColecoVision/SG-1000 (blueMSX)"

msgctxt "Addon Description"
msgid "BlueMSX is a rich MSX emulator. It supports most common machines and a wide variety of extension hardware."
msgstr "BlueMSX — это многофункциональный эмулятор MSX. Он поддерживает большинство распространённых компьютеров и широкий спектр расширенного оборудования."

msgctxt "Addon Disclaimer"
msgid "Authors: Daniel Vik, Benoit Delvaux, Tomas Karlsson, Johan van Leur, Ricardo Bittencourt and Ray Zero"
msgstr "Авторы: Daniel Vik, Benoit Delvaux, Tomas Karlsson, Johan van Leur, Ricardo Bittencourt и Ray Zero"

msgctxt "#30001"
msgid "Machine Type (Restart)"
msgstr "Тип компьютера (перезапуск)"

msgctxt "#30002"
msgid "Crop Overscan"
msgstr "Обрезка вылетов развёртки"

msgctxt "#30003"
msgid "VDP Sync Type (Restart)"
msgstr "Тип синхронизации VDP (перезапуск)"

msgctxt "#30004"
msgid "No Sprite Limit"
msgstr "Без ограничения спрайтов"

msgctxt "#30005"
msgid "Sound YM2413 Enable (Restart)"
msgstr "Включить звуковой YM2413 (перезапуск)"

msgctxt "#30006"
msgid "Cart Mapper Type (Restart)"
msgstr "Тип маппера картриджа (перезапуск)"

msgctxt "#30007"
msgid "Auto Rewind Cassette"
msgstr "Автоматическая перемотка кассеты"

msgctxt "#30008"
msgid "I/O Sound Enable"
msgstr "Включить звук ввода-вывода"

msgctxt "#30009"
msgid "Colecovision Keyboard Mapping"
msgstr "Сопоставление клавиатуры Colecovision"

msgctxt "#30010"
msgid "Patch Colecovision ROM Fast Boot (Close Content)"
msgstr "Патч для быстрой загрузки ROM Colecovision (закрыть содержимое)"

msgctxt "#30011"
msgid "Use F12 to hard reset and restart emulation"
msgstr "Использовать F12 для жёсткого сброса и перезапуска эмуляции"

msgctxt "#30012"
msgid "Additional MSX Sound Cartridge (Restart)"
msgstr "Дополнительный звуковой картридж MSX (перезапуск)"

msgctxt "#30013"
msgid "SunriseIDE Enable (Restart)"
msgstr "Включить SunriseIDE (перезапуск)"

