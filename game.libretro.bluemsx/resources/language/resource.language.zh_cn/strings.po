msgctxt "Addon Summary"
msgid "MSX/SVI/ColecoVision/SG-1000 (blueMSX)"
msgstr "MSX/SVI/ColecoVision/SG-1000 (blueMSX)"

msgctxt "Addon Description"
msgid "BlueMSX is a rich MSX emulator. It supports most common machines and a wide variety of extension hardware."
msgstr "BlueMSX 是一个富 MSX 模拟器。它支持最常见的机型和各种扩展硬件。"

msgctxt "Addon Disclaimer"
msgid "Authors: Daniel Vik, Benoit Delvaux, Tomas Karlsson, Johan van Leur, Ricardo Bittencourt and Ray Zero"
msgstr "作者：Daniel Vik、Benoit Delvaux、Tomas Karlsson、Johan van Leur、Ricardo Bittencourt 和 Ray Zero"

